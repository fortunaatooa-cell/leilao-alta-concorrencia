<mxfile host="app.diagrams.net"><diagram id="leilao" name="Leilão - Dados AWS"><mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="1020" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="&lt;b&gt;Leilão online — da decisão do lance ao dado confiável&lt;/b&gt;" style="text;html=1;align=left;fontSize=18;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="30" y="5" width="900" height="30" as="geometry"/></mxCell><mxCell id="cloud" value="AWS Cloud · sa-east-1 · conta do domínio &quot;Leilões&quot; (data mesh)" style="outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#232F3E;dashed=0;" vertex="1" parent="1"><mxGeometry x="170" y="45" width="1270" height="830" as="geometry"/></mxCell><mxCell id="la" value="&lt;b&gt;① Transacional — decide o lance em tempo real&lt;/b&gt; (base operacional que decide)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FDF0E6;strokeColor=#ED7100;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontSize=13;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="190" y="85" width="1230" height="200" as="geometry"/></mxCell><mxCell id="lb" value="&lt;b&gt;② Ingestão em streaming — camada SOR&lt;/b&gt; (System of Record: dado bruto, como veio — CDC, at-least-once)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F2ECFF;strokeColor=#8C4FFF;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontSize=13;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="190" y="305" width="1230" height="200" as="geometry"/></mxCell><mxCell id="lc" value="&lt;b&gt;③ SOT → SPEC, governança e consumo&lt;/b&gt; (SOT = Source of Truth · SPEC = Specialized)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#EEF6E8;strokeColor=#7AA116;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontSize=13;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="190" y="525" width="1230" height="330" as="geometry"/></mxCell><mxCell id="u" value="Usuários" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.users;" vertex="1" parent="1"><mxGeometry x="50" y="150" width="70" height="70" as="geometry"/></mxCell><mxCell id="apigw" value="API Gateway&lt;br&gt;REST + WebSocket&lt;br&gt;(push do novo preço)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;" vertex="1" parent="1"><mxGeometry x="300" y="150" width="70" height="70" as="geometry"/></mxCell><mxCell id="fn" value="Lambda — Bid API&lt;br&gt;valida e decide" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="560" y="150" width="70" height="70" as="geometry"/></mxCell><mxCell id="ddb" value="DynamoDB&lt;br&gt;escrita condicional&lt;br&gt;(idempotente + versão)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1"><mxGeometry x="820" y="150" width="70" height="70" as="geometry"/></mxCell><mxCell id="kds" value="Kinesis Data Streams&lt;br&gt;(eventos de lance)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.kinesis_data_streams;" vertex="1" parent="1"><mxGeometry x="820" y="370" width="70" height="70" as="geometry"/></mxCell><mxCell id="fh" value="Data Firehose" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.kinesis_data_firehose;" vertex="1" parent="1"><mxGeometry x="1020" y="370" width="70" height="70" as="geometry"/></mxCell><mxCell id="s3b" value="S3 — SOR&lt;br&gt;(bruto, imutável)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1"><mxGeometry x="1220" y="370" width="70" height="70" as="geometry"/></mxCell><mxCell id="glue" value="Glue ETL + Data Quality&lt;br&gt;dedup · ordem · LGPD" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.glue;" vertex="1" parent="1"><mxGeometry x="1220" y="590" width="70" height="70" as="geometry"/></mxCell><mxCell id="s3sg" value="S3 — SOT / SPEC&lt;br&gt;(Iceberg / Parquet)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1"><mxGeometry x="1020" y="590" width="70" height="70" as="geometry"/></mxCell><mxCell id="lf" value="Lake Formation + Glue Data Catalog&lt;br&gt;(controle de acesso)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lake_formation;" vertex="1" parent="1"><mxGeometry x="1020" y="735" width="70" height="70" as="geometry"/></mxCell><mxCell id="athena" value="Athena&lt;br&gt;(SQL)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.athena;" vertex="1" parent="1"><mxGeometry x="820" y="590" width="70" height="70" as="geometry"/></mxCell><mxCell id="qs" value="QuickSight&lt;br&gt;(dashboards)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.quicksight;" vertex="1" parent="1"><mxGeometry x="560" y="590" width="70" height="70" as="geometry"/></mxCell><mxCell id="cw" value="CloudWatch&lt;br&gt;(latência, alarmes, DQ)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;" vertex="1" parent="1"><mxGeometry x="1220" y="150" width="70" height="70" as="geometry"/></mxCell><mxCell id="e1" value="1. lance" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#ED7100;strokeWidth=2;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=0;" edge="1" parent="1" source="u" target="apigw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#ED7100;strokeWidth=2;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=0;" edge="1" parent="1" source="apigw" target="fn"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="2. grava se versão não mudou" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#ED7100;strokeWidth=2;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=0;" edge="1" parent="1" source="fn" target="ddb"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="3. DynamoDB Stream (CDC)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#8C4FFF;strokeWidth=2;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=0;" edge="1" parent="1" source="ddb" target="kds"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#8C4FFF;strokeWidth=2;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=0;" edge="1" parent="1" source="kds" target="fh"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#8C4FFF;strokeWidth=2;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=0;" edge="1" parent="1" source="fh" target="s3b"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="5. SOR → SOT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#7AA116;strokeWidth=2;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=0;" edge="1" parent="1" source="s3b" target="glue"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#7AA116;strokeWidth=2;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=0;" edge="1" parent="1" source="glue" target="s3sg"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#7AA116;strokeWidth=2;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=0;" edge="1" parent="1" source="s3sg" target="athena"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#7AA116;strokeWidth=2;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="lf" target="s3sg"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#7AA116;strokeWidth=2;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=0;" edge="1" parent="1" source="athena" target="qs"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="leg" value="&lt;b&gt;Leitura em 30 s:&lt;/b&gt; ① o lance só é aceito quando o DynamoDB grava de forma &lt;b&gt;condicional e atômica&lt;/b&gt; (sem race condition, sem duplicado; a ordem é a do commit). ② cada decisão vira evento via &lt;b&gt;CDC&lt;/b&gt;; o lake recebe em &lt;b&gt;at-least-once&lt;/b&gt; e fora de ordem, então a SOT &lt;b&gt;deduplica por lance_id, reordena por sequência e pseudonimiza o usuário&lt;/b&gt;. ③ Data Quality reconcilia a SPEC com o sistema operacional; Lake Formation controla quem vê o quê; consumo por SQL/dashboards." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;align=left;verticalAlign=middle;spacingLeft=12;spacingTop=6;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="30" y="895" width="1410" height="95" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>