tyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#8C4FFF;strokeWidth=2;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=0;" edge="1" parent="1" source="ddb" target="not"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="4. novo preço" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#8C4FFF;strokeWidth=2;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=0;" edge="1" parent="1" source="not" target="ws"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="push" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#8C4FFF;strokeWidth=2;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="ws" target="u"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#8C4FFF;strokeWidth=2;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="not" target="dlq"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="no horário" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#7AA116;strokeWidth=2;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=0;" edge="1" parent="1" source="sch" target="enc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="fecha (condicional)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#7AA116;strokeWidth=2;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=0;" edge="1" parent="1" source="enc" target="ddb"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="leg" value="&lt;b&gt;Leitura em 30 s:&lt;/b&gt; ① o lance só é aceito quando o DynamoDB grava &lt;b&gt;atomicamente&lt;/b&gt;: &lt;i&gt;lance_id&lt;/i&gt; ainda não existe (idempotência) E a versão do leilão é a que foi lida (sem race condition) E o leilão está aberto. A ordem oficial é a ordem desses commits. ② cada commit sai no DynamoDB Streams; a Lambda avisa todos os participantes por WebSocket — se falhar, vai para a DLQ e o lance continua válido. ③ o Scheduler encerra o leilão no horário; a própria condição de escrita impede lances depois do fim." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;align=left;verticalAlign=middle;spacingLeft=12;spacingTop=6;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="30" y="855" width="1410" height="85" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>